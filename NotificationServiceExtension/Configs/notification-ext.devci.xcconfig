#include "../../Configs/base.devci.xcconfig"

OTHER_SWIFT_FLAGS = $(inherited) $(BASE_SWIFT_FLAGS) "-DNOTIFICATION_SERVICE_EXTENSION"

// Must match polkadot-app.devci.xcconfig, or Xcode rejects the embedded extension's bundle id.
APP_MAIN_BUNDLE = io.pcf.polkadotapp
APP_GROUP       = group.pcf.polkadotapp
BUNDLE = $(APP_MAIN_BUNDLE).NotificationServiceExtension
