// Must match polkadot-app.dev.xcconfig (APP_MAIN_BUNDLE, APP_GROUP) to read the app's shared container.
// -DNOTIFICATION_SERVICE_EXTENSION selects the extension's serial Core Data topology.

#include "../../Configs/base.release.xcconfig"

OTHER_SWIFT_FLAGS = $(inherited) "-DNOTIFICATION_SERVICE_EXTENSION"

APP_NAME        = $(BRAND_DISPLAY_NAME)
APP_MAIN_BUNDLE = io.pcf.polkadotapp.devnet
APP_GROUP       = group.pcf.polkadotapp.devnet
BUNDLE          = $(APP_MAIN_BUNDLE).NotificationServiceExtension

// PCF legal pages; brand.xcconfig keeps upstream values.
BRAND_TERMS_HOST   = pcf.network/legal/user-terms/
BRAND_PRIVACY_HOST = pcf.network/legal/privacy/
