// Devnet build distributed through TestFlight. Includes base.release.xcconfig for the brand and
// identity defaults, but not $(BASE_SWIFT_FLAGS): the debug flags disable the local-auth gate.
// -DDEV selects the nightly-* chain ids, the devnet asset set and the `build_channel = dev`
// Remote Config signal. FEATURE_PRIZES is left out because it excludes FEATURE_DIMS_FULL.

#include "../../Configs/base.release.xcconfig"

// -DTRUAPI_RUNTIME_DEFAULT makes the TrUAPI core the default product runtime, as on Nightly.
// Testers can switch a device back to the native runtime in Debug Settings.
OTHER_SWIFT_FLAGS = $(inherited) "-DDEV" "-DTESTNET_FEATURE" "-DFEATURE_DIMS" "-DFEATURE_DIMS_FULL" "-DFEATURE_PRODUCTS" "-DFEATURE_SIGN_IN" "-DFEATURE_INPUT" "-DTRUAPI_RUNTIME_DEFAULT"

// base.release.xcconfig leaves ICON_SUFFIX empty; must stay after the #include.
ICON_SUFFIX     = Dev

// The shared container and the keychain group both follow the bundle id.
APP_NAME        = $(BRAND_DISPLAY_NAME)
APP_MAIN_BUNDLE = io.pcf.polkadotapp.devnet
APP_GROUP       = group.pcf.polkadotapp.devnet
BUNDLE          = $(APP_MAIN_BUNDLE)

// PCF legal pages; brand.xcconfig keeps upstream values.
BRAND_TERMS_HOST   = pcf.network/legal/user-terms/
BRAND_PRIVACY_HOST = pcf.network/legal/privacy/
