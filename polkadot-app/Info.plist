<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).statement-renewal</string>
	</array>
	<key>BrandAppGroup</key>
	<string>$(APP_GROUP)</string>
	<key>BrandBundleRoot</key>
	<string>$(APP_MAIN_BUNDLE)</string>
	<key>BrandCashSymbol</key>
	<string>$(BRAND_CASH_SYMBOL)</string>
	<key>BrandContactEmail</key>
	<string>$(BRAND_CONTACT_EMAIL)</string>
	<key>BrandDeeplinkBase</key>
	<string>$(BRAND_DEEPLINK)</string>
	<key>BrandDeeplinkScheme</key>
	<string>$(DEEPLINK)</string>
	<key>BrandDisplayName</key>
	<string>$(BRAND_DISPLAY_NAME)</string>
	<key>BrandFiatSymbol</key>
	<string>$(BRAND_FIAT_SYMBOL)</string>
	<key>BrandPrivacyHost</key>
	<string>$(BRAND_PRIVACY_HOST)</string>
	<key>BrandShareRoot</key>
	<string>$(BRAND_SHARE_ROOT)</string>
	<key>BrandTermsHost</key>
	<string>$(BRAND_TERMS_HOST)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>${APP_NAME}</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string></string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(DEEPLINK)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>novawallet</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Polkadot sets alarms to remind you about upcoming events, for example 5 minutes before a game you joined starts.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Polkadot adds games you join to your calendar, for example with a reminder 5 minutes before the game starts.</string>
	<key>NSCameraUsageDescription</key>
	<string>Polkadot uses your camera to scan a contact's QR code and for video calls, for example to open a chat with a friend by scanning the code from their phone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Polkadot uses Face ID to confirm it's you, for example before showing your account backup or restoring your account.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Polkadot uses your local network to connect calls directly, for example when you call a contact on the same Wi‑Fi network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Polkadot uses your microphone for voice and video calls, for example so a contact can hear you when you call them from a chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Polkadot saves photos and videos from chats to your library when you choose to, for example when you tap Save Image on a photo a contact sent you.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
		<string>fetch</string>
		<string>voip</string>
		<string>processing</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
