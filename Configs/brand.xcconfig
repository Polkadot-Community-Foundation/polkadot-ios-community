// Local brand identity.
// Created from Configs/brand.template.xcconfig; see that file for the key contract.

BRAND_DISPLAY_NAME = Polkadot
BRAND_BUNDLE_ROOT = io.pcf.polkadotapp

// The registered PCF App Group is group.pcf.polkadotapp, NOT group.$(APP_MAIN_BUNDLE): the app id gained the
// io. prefix after the group was created. Entitlements and Info.plist read $(APP_GROUP), so this pins both.
APP_GROUP = group.pcf.polkadotapp
BRAND_DEEPLINK = polkadotapp
BRAND_SHARE_ROOT = dot.li
BRAND_SHARE_ROOT_TEST = paseo.li
BRAND_CASH_SYMBOL = CASH
BRAND_FIAT_SYMBOL = $
BRAND_TERMS_HOST = www.polkadotcommunity.foundation/appterms
BRAND_PRIVACY_HOST = www.polkadotcommunity.foundation/privacy
BRAND_CONTACT_EMAIL = info@pcf.network
